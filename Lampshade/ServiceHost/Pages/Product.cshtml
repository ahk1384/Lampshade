@page "{id}"
@using _0_Framework.Application
@using CommnetManagement.Infrastructure.EFCore
@model ProductModel
@inject IAuthHelper _authHelper
@{
    ViewData["Title"] = Model.Product.Name;
    ViewData["keywords"] = Model.Product.Keywords;
    ViewData["metaDescription"] = Model.Product.MetaDescription;
}

<div class="breadcrumb-area section-space--half">
    <div class="container wide">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-wrapper breadcrumb-bg">
                    <div class="breadcrumb-content">
                        <h1 class="breadcrumb-content__title">@Model.Product.Name</h1>
                        <ul class="breadcrumb-content__page-map">
                            <li>
                                <a asp-page="/Index">صفحه اصلی</a>
                            </li>
                            <li>
                                <a asp-page="/ProductCategory"
                                   asp-route-id="@Model.Product.CategorySlug">@Model.Product.Category</a>
                            </li>
                            <li class="active">@Model.Product.Name</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-content-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page-wrapper">
                    <div class="page-content-wrapper">
                        <div class="single-product-main-content-area section-space" style="direction: ltr;">
                            <div class="row" style="display: flex; flex-direction: row-reverse">
                                <div class="col-lg-6">
                                    <div class="product-details-slider-area">
                                        <div class="big-image-wrapper">
                                            <div
                                                class="product-details-big-image-slider-wrapper product-details-big-image-slider-wrapper--bottom-space ht-slick-slider"
                                                data-slick-setting='{
                                                    "slidesToShow": 1,
                                                    "slidesToScroll": 1,
                                                    "arrows": false,
                                                    "autoplay": false,
                                                    "autoplaySpeed": 5000,
                                                    "fade": true,
                                                    "speed": 500,
                                                    "prevArrow": {"buttonClass": "slick-prev", "iconClass": "fa fa-angle-left" },
                                                    "nextArrow": {"buttonClass": "slick-next", "iconClass": "fa fa-angle-right" }
                                                }' data-slick-responsive='[
                                                    {"breakpoint":1501, "settings": {"slidesToShow": 1, "arrows": false} },
                                                    {"breakpoint":1199, "settings": {"slidesToShow": 1, "arrows": false} },
                                                    {"breakpoint":991, "settings": {"slidesToShow": 1, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":767, "settings": {"slidesToShow": 1, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":575, "settings": {"slidesToShow": 1, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":479, "settings": {"slidesToShow": 1, "arrows": false, "slidesToScroll": 1} }
                                                ]'>

                                                <div class="single-image">
                                                    <img src="~/ProductPictures/@Model.Product.Picture"
                                                         class="img-fluid"
                                                         alt="@Model.Product.Picture">
                                                </div>
                                                @foreach (var picture in Model.Product.Pictures)
                                                {
                                                    <div class="single-image">
                                                        <img src="~/ProductPictures/@picture.Picture" class="img-fluid"
                                                             alt="@picture.PictureAlt" title="@picture.PictureTitle">
                                                    </div>
                                                }
                                            </div>
                                        </div>


                                        <div
                                            class="product-details-small-image-slider-wrapper product-details-small-image-slider-wrapper--horizontal-space ht-slick-slider"
                                            data-slick-setting='{
                                                    "slidesToShow": 4,
                                                    "slidesToScroll": 1,
                                                    "arrows": true,
                                                    "autoplay": false,
                                                    "autoplaySpeed": 5000,
                                                    "speed": 500,
                                                    "asNavFor": ".product-details-big-image-slider-wrapper",
                                                    "focusOnSelect": true,
                                                    "centerMode": false,
                                                    "prevArrow": {"buttonClass": "slick-prev", "iconClass": "fa fa-angle-left" },
                                                    "nextArrow": {"buttonClass": "slick-next", "iconClass": "fa fa-angle-right" }
                                                }' data-slick-responsive='[
                                                    {"breakpoint":1501, "settings": {"slidesToShow": 3, "arrows": false} },
                                                    {"breakpoint":1199, "settings": {"slidesToShow": 3, "arrows": false} },
                                                    {"breakpoint":991, "settings": {"slidesToShow": 5, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":767, "settings": {"slidesToShow": 3, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":575, "settings": {"slidesToShow": 3, "arrows": false, "slidesToScroll": 1} },
                                                    {"breakpoint":479, "settings": {"slidesToShow": 2, "arrows": false, "slidesToScroll": 1} }
                                                ]'>
                                            <div class="single-image">
                                                <img src="~/ProductPictures/@Model.Product.Picture" class="img-fluid"
                                                     alt="@Model.Product.Picture">
                                            </div>
                                            @foreach (var picture in Model.Product.Pictures)
                                            {
                                                <div class="single-image">
                                                    <img src="~/ProductPictures/@picture.Picture" class="img-fluid"
                                                         alt="@picture.PictureAlt" title="@picture.PictureTitle">
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="single-product-content-description">
                                        <p class="single-info">
                                            <a asp-page="/ProductCategory"
                                               asp-route-id="@Model.Product.CategorySlug">@Model.Product.Category</a>
                                        </p>
                                        <h2 class="product-title">@Model.Product.Name</h2>

                                        @if (Model.Product.IsInStock)
                                        {
                                            <p class="single-grid-product__price" style="direction: rtl">
                                                @if (Model.Product.HasDiscount)
                                                {
                                                    <span
                                                        class="main-price discounted">@Model.Product.Price تومان</span>
                                                    <span
                                                        class="discounted-price">@Model.Product.PriceWithDiscount تومان</span>
                                                }
                                                else
                                                {
                                                    <span class="main-price">@Model.Product.Price تومان</span>
                                                }
                                            </p>
                                        }
                                        <span class="review-count">
                                            <a href="#review"
                                               onclick="activeComments()">(@Model.Product.Comments.Count نظرات)</a> | <a
                                                href="#message" onclick="activeComments()">نظر دهید</a>
                                            

                                        </span>
                                        <div class="product-rating">
                                            <span class="rating">
                                                @for (var i = 1; i <= 5; i++)
                                                {
                                                    if (i <= Model.Product.Rating)
                                                    {
                                                        <i class="ion-android-star active"></i>
                                                    }
                                                    else if (1 > i - Model.Product.Rating && i - Model.Product.Rating >= 0.3)
                                                    {
                                                        <i class="ion-android-star-half"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="ion-android-star-outline"></i>
                                                    }
                                                }
                                                <label class="single-info">@Model.Product.Rating</label>
                                            </span>
                                        </div>

                                        <p class="single-info">کد محصول: <span class="value">@Model.Product.Code</span>
                                        </p>
                                        <p class="single-info">
                                            @if (Model.Product.IsInStock)
                                            {
                                                <span class="text-success">موجود در انبار</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">محصول ناموجود</span>
                                            }
                                        </p>

                                        <p class="product-description">
                                            @Model.Product.ShortDescription
                                        </p>
                                        @if (Model.Product.IsInStock)
                                        {
                                            @if (Model.Product.HasDiscount)
                                            {
                                                <div class="product-countdown"
                                                     data-countdown="@Model.Product.DiscountExpireDate"></div>
                                            }

                                            <form method="post" asp-page="/Product" asp-page-handler="AddToCart">
                                                <input type="hidden" name="id" value="@Model.Product.Slug"/>
                                                <div class="product-actions">
                                                    <div class="quantity-selection">
                                                        <label>تعداد</label>
                                                        <input type="number" value="1" min="1" id="productCount"
                                                               name="count">
                                                    </div>
                                                    <div class="product-buttons">
                                                        <button type="submit" class="cart-btn">
                                                            @if (_authHelper.IsAuthenticated())
                                                            {
                                                                <i class="ion-bag">افزودن به سبد خرید</i>
                                                            }
                                                            else
                                                            {
                                                                <i class="ion-bag"
                                                                   onclick="addToCart('@Model.Product.Id', '@Model.Product.Name', '@Model.Product.DoublePrice', '@Model.Product.Picture','@Model.Product.IsInStock','@Model.Product.DiscountRate' , '@Model.Product.Slug')">افزودن
                                                                    به سبد خرید</i>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        }
                                        <div class="social-share-buttons mt-20">
                                            <h5>این محصول را به اشتراک بگذارید</h5>
                                            <ul>
                                                <li>
                                                    <a class="twitter" href="#">
                                                        <i class="fa fa-twitter"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="facebook" href="#">
                                                        <i class="fa fa-facebook"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="google-plus" href="#">
                                                        <i class="fa fa-google-plus"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="pinterest" href="#">
                                                        <i class="fa fa-pinterest"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        <p class="single-info mb-0">
                                            تگ ها: @Model.Product.Keywords
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="product-description-review-area">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div
                                        class="tab-slider-wrapper product-description-review-container  section-space--inner">
                                        <nav>
                                            <div class="nav nav-tabs justify-content-center" id="nav-tab"
                                                 role="tablist">
                                                <a class="nav-item nav-link active" id="description-tab"
                                                   data-toggle="tab" href="#product-description" role="tab"
                                                   aria-selected="true">
                                                    توضیحات
                                                </a>
                                                <a class="nav-item nav-link" id="review-tab" data-toggle="tab"
                                                   href="#review" role="tab" aria-selected="false">
                                                    نظرات (@Model.Product.Comments.Count)
                                                </a>
                                            </div>
                                        </nav>
                                        <div class="tab-content" id="nav-tabContent">
                                            <div class="tab-pane fade show active" id="product-description"
                                                 role="tabpanel" aria-labelledby="description-tab">
                                                <div class="product-description">
                                                    @Model.Product.Description
                                                </div>
                                            </div>
                                            <div class="tab-pane fade" id="review" role="tabpanel"
                                                 aria-labelledby="review-tab">
                                                @if (Model.Product.Comments.Count == 0)
                                                {
                                                    <h3 style="margin-bottom:3rem ; color: rgba(217,35,95,0.89)">اولین
                                                        نفر باشید ...</h3>
                                                }
                                                @foreach (var comment in Model.Product.Comments)
                                                {
                                                    <div class="ratings-wrapper">
                                                        <div class="sin-ratings">
                                                            <div class="rating-author">
                                                                <h3 style="font-weight: 650 ; margin-top: 0.4rem ">@comment.Name</h3>
                                                                <div class="sin-list float-right"
                                                                     style="margin-right: 1rem " id="ratingStar">
                                                                    @for (var i = 1; i <= 5; i++)
                                                                    {
                                                                        if (i <= comment.Rating)
                                                                        {
                                                                            <i class="fa fa-star active"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="fa fa-star"></i>
                                                                        }
                                                                    }
                                                                    <label
                                                                        id="ratingCommentLabel">@comment.Rating</label>
                                                                </div>

                                                            </div>
                                                            <p style="margin-right: 3.5rem">@comment.Message</p>
                                                        </div>
                                                    </div>
                                                }


                                                <div class="rating-form-wrapper fix">

                                                    <h3>نظر خود را به ما بگویید</h3>
                                                    <form method="post">
                                                        <div class="rating-list">
                                                            <div class="sin-list float-right" id="ratingStars">
                                                                <i class="fa fa-star active" onclick="loadStars(1)"></i>
                                                                <i class="fa fa-star" onclick="loadStars(2)"></i>
                                                                <i class="fa fa-star" onclick="loadStars(3)"></i>
                                                                <i class="fa fa-star" onclick="loadStars(4)"></i>
                                                                <i class="fa fa-star" onclick="loadStars(5)"></i>
                                                                <label for="rating" name="rating"
                                                                       id="ratingLabel">1</label>
                                                                <input type="hidden" name="rating" id="rating"
                                                                       value="@Model.Product.Rating">
                                                            </div>
                                                        </div>
                                                        <div class="rating-form row" id="ratingForm">
                                                            @if (!_authHelper.IsAuthenticated())
                                                            {
                                                                <div class="col-md-6 col-12 form-group">
                                                                    <label for="name">نام:</label>
                                                                    <input id="name" required placeholder="مثال: علی علوی"
                                                                           name="name" type="text">
                                                                </div>
                                                            }
                                                            <div class="col-md-6 col-12 form-group">
                                                                <label for="email">ایمیل:</label>
                                                                <input id="email" required
                                                                       placeholder="مثال: contact@atriya.com"
                                                                       name="email" type="email">
                                                            </div>

                                                            <div class="col-12 form-group">
                                                                <label for="your-review">نظر شما:</label>
                                                                <textarea required minlength="5" name="message"
                                                                          id="message"
                                                                          placeholder="نظر خود را بنویسید ..."></textarea>
                                                            </div>
                                                            <input type="hidden" name="ownerRecordId"
                                                                   value="@Model.Product.Id"/>
                                                            <input type="hidden" name="type"
                                                                   value="@CommentType.Product"/>
                                                            <input type="hidden" name="productSlug"
                                                                   value="@Model.Product.Slug"/>
                                                            <div class="col-12">
                                                                <input value="ارسال" type="submit">
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function activeComments() {
        const des = document.getElementById("description-tab");
        const tabdes = document.getElementById("product-description");
        tabdes.classList.remove("active");
        tabdes.classList.remove("show");
        des.classList.remove("active");
        des.ariaSelected = false;
        const review = document.getElementById("review-tab");
        const reiviwTab = document.getElementById("review");
        reiviwTab.classList.add("active");
        reiviwTab.classList.add("show");
        review.classList.add("active")
        review.ariaSelected = true;
    }

    function loadStars(count) {
        let rating = count;
        let c = 0;
        const stars = document.getElementById("ratingStars").querySelectorAll(".fa-star");
        $("#ratingLabel").text(count);
        document.getElementById("rating").value = count;
        stars.forEach(star => {
            star.classList.remove("active");
        })
        stars.forEach(star => {
            if (c < rating) {
                star.classList.add("active");
                c++;
            }
        });
    }

    async function submitRating() {
        const comment = document.getElementById("comment").value;

        const data = {
            rating: rating,
            comment: comment
        };

        await fetch("/api/review", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        });
    }
</script>
