@page
@model RegisterModel
@{
    ViewData["Title"] = "ورود و ثبت نام";
}

<div class="breadcrumb-area section-space--half">
    <div class="container wide">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-wrapper breadcrumb-bg">
                    <div class="breadcrumb-content">
                        <h2 class="breadcrumb-content__title"> ثبت نام</h2>
                        <ul class="breadcrumb-content__page-map">
                            <li>
                                <a asp-page="/Index">صفحه اصلی</a>
                            </li>
                            <li class="active"> ثبت نام</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-content-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page-wrapper">
                    <div class="page-content-wrapper">
                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12 col-xs-12">
                                @if (Model.RegisterMessage != null)
                                {
                                    <div class="alert alert-danger">@Model.RegisterMessage</div>
                                }
                                <form method="post" asp-page-handler="Register">
                                    <div class="login-form">
                                        <h4 class="login-title">ثبت نام</h4>
                                        <div class="row">
                                            <div class="col-md-6 col-12 mb-20">
                                                <label >نام کامل</label>
                                                <input required minlength="5" type="text" asp-for="command.Fullname"  placeholder="نام کامل">
                                                <span asp-validation-for="command.Fullname" class="error"></span>
                                            </div>
                                            <div class="col-md-6 col-12 mb-20">
                                                <label >نام کاربری</label>
                                                <input required minlength="5" type="text" asp-for="command.Username"  placeholder="نام کاربری">
                                                <span asp-validation-for="command.Username" class="error"></span>
                                            </div>
                                            <div class="col-md-12 mb-20">
                                                <label >موبایل</label>
                                                <input required minlength="10" type="number" asp-for="command.Mobile"  placeholder="موبایل">
                                                <span asp-validation-for="command.Mobile" class="error"></span>
                                            </div>
                                            <div class="col-md-6 mb-20">
                                                <label>کلمه رمز</label>
                                                <input required minlength="8" type="password" asp-for="command.Password" placeholder="کلمه رمز">
                                                <span asp-validation-for="command.Password" class="error"></span>
                                            </div>
                                            <div class="col-md-6 mb-20">
                                                <label>تایید کلمه رمز</label>
                                                <input required minlength="8" type="password" name="rePassword" placeholder="تایید کلمه رمز">
                                            </div>
                                            <div class="col-12">
                                                <a asp-page="/Login" class="login-title">ورود</a>
                                                <button type="submit"class="register-button mt-0">ثبت نام</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>