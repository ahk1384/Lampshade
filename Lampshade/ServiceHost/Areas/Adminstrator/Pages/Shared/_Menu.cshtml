@using _0_Framework.Application
@using AccountManagement.Infrastructure.Configuration.Permissions
@using BlogManagement.Infrastructure.Configuration.Permissions
@using CommentManagement.Infrastructure.Configuration.Permissions
@using DiscountManagement.Infrastructure.Configuration.Permissions
@using InventoryManagement.Infrastructure.Configuration.Permissions
@using ShopManagement.Infrastructure.Configuration.Permissions
@inject IAuthHelper AuthHelper;
@{
    var currentAccount = AuthHelper.CurrentAccountInfo();
}
<div class="left side-menu">
    <div class="sidebar-inner slimscrollleft">
        <!--- Divider -->
        <div id="sidebar-menu">

            <ul>
                <li>
                    <div class="user-info" style="margin-right: 3px">
                        <div style="margin-bottom: 5px">
                            <img style="margin-right: 9px ; margin-top: 8px; width: 42px;height: 42px"
                                 src="~/ProductPictures/@currentAccount.ProfilePhoto" alt="" class="thumb-md img-circle"
                                 style="margin-bottom: 20px ; margin-right: 7px">
                        </div>
                        <a style="margin-right: 15px ">
                            @currentAccount.Fullname
                        </a>
                        <p class="text-muted" style="margin-right:15px">@currentAccount.Role</p>
                    </div>
                </li>
                <li>
                    <a asp-page="/Index" class="waves-effect active">
                        <i class="md md-home"></i><span> داشبورد </span>
                    </a>
                </li>
                <li permission="@CommentPermissions.CommentBase">
                <a asp-page="/Comments/Index" class="waves-effect">
                        <i class="md md-comment"></i><span> کامنت ها </span>
                    </a>
                </li>
                <li permission="@InventoryPermissions.BaseInventory">
                    <a asp-page="/Inventory/Index" class="waves-effect">
                        <i class="md md-book"></i><span> انبارداری </span>
                    </a>
                </li>
                <li permission="@ShopPermissions.BaseOrder">
                    <a asp-page="/Shop/Orders/Index" class="waves-effect">
                        <i class="md md-list"></i><span> سفارشات </span>
                    </a>
                </li>
                <li permission="@ShopPermissions.BaseShop" p class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-store"></i><span> فروشگاه </span>
                        <span class="pull-right">
                            <i class="md md-add"></i>
                        </span>
                    </a>
                    <ul class="list-unstyled">
                        <li permission="@ShopPermissions.BaseProduct">
                            <a asp-page="/Shop/Product/Index">محصولات</a>
                        </li>
                        <li permission="@ShopPermissions.BaseProductCategory">
                            <a asp-page="/Shop/ProductCategories/Index">گروه محصولات</a>
                        </li>
                        <li permission="@ShopPermissions.BaseProductPicture">
                            <a asp-page="/Shop/ProductPictures/Index">عکس محصولات</a>
                        </li>
                        <li permission="@ShopPermissions.BaseSlide">
                            <a asp-page="/Shop/Slides/Index">اسلایدر</a>
                        </li>
                    </ul>
                </li>
                <li permission="@DiscountPermissions.DiscountBase" class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-trending-down"></i><span> سیستم تخفیفات </span>
                        <span class="pull-right">
                            <i class="md md-add"></i>
                        </span>
                    </a>
                    <ul class="list-unstyled">
                        <li permission="DiscountPermissions.CustomerDiscountBase">
                            <a asp-page="/Discounts/CustomerDiscount/Index">تخفیف مشتری</a>
                        </li>
                        <li permission="DiscountPermissions.ColleagueDiscountBase">
                            <a asp-page="/Discounts/ColleagueDiscount/Index">تخفیف همکاری</a>
                        </li>
                    </ul>
                </li>
                <li permission="AccountPermissions.AccountsBase" class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-person"></i><span> سیستم کاربران </span>
                        <span class="pull-right">
                            <i class="md md-add"></i>
                        </span>
                    </a>
                    <ul class="list-unstyled">
                        <li permission="AccountPermissions.AccountBase">
                            <a asp-page="/Accounts/Account/Index">کاربران</a>
                        </li>
                        <li permission="AccountPermissions.RoleBase">
                            <a asp-page="/Accounts/Role/Index">نقش ها</a>
                        </li>
                    </ul>
                </li>
                <li permission="@BlogPermissions.BlogBase" class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-note-add"></i><span> سیستم بلاگینگ </span>
                        <span class="pull-right">
                            <i class="md md-add"></i>
                        </span>
                    </a>
                    <ul class="list-unstyled">
                        <li permission="BlogPermissions.ArticleBase">
                            <a asp-page="/Blog/Articles/Index">مقالات</a>
                        </li>
                        <li permission="BlogPermissions.ArticleCategoryBase">
                            <a asp-page="/Blog/ArticleCategories/Index">گروه مقالات</a>
                        </li>
                    </ul>
                </li>
                <li>
                    <a asp-page="/Login" asp-page-handler="Logout" class="waves-effect active">
                        <i class="fa fa-sign-out"></i><span> خروج </span>
                    </a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>