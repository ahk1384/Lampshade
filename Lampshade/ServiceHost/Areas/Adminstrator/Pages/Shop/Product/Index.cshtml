@page
@using ShopManagement.Infrastructure.Configuration.Permissions
@model ServiceHost.Areas.Adminstrator.Pages.Shop.Product.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت محصولات";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p permission="ShopPermissions.CreateProduct" class="pull-left">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">ایجاد محصول جدید</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div permission="ShopPermissions.SearchProducts" class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در محصولات</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Name"></label>
                        <input class="form-control" asp-for="SearchModel.Name" placeholder="نام محصول">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Code"></label>
                        <input class="form-control" asp-for="SearchModel.Code" placeholder="کد">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.CategoryId"></label>
                        <select class="form-control" asp-for="SearchModel.CategoryId"
                                asp-items="Model.ProductCategories">
                            <option value="0">گروه محصولی ...</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index"
                       asp-page-handler="Active">مشاهده همه</a>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index"
                       asp-page-handler="Deleted">مشاهده حذف شده ها</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست محصولات (@Model.Products.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>عکس</th>
                                <th>نام</th>
                                <th>کد</th>
                                <th>گروه</th>
                                <th>تاریخ تولید</th>
                                <th>امتیاز محصول</th>
                                <th>عملیات</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.Products)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <img src="~/ProductPictures/@item.Picture" style="height: 70px; width: 70px;"/>
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Code</td>
                                    <td>@item.Category</td>
                                    <td>@item.CreationDate</td>
                                    <td>@item.Rating</td>
                                    <td>
                                        <a permission="ShopPermissions.EditProduct"
                                           class="btn btn-warning pull-right m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                            <i class="fa fa-edit"></i> ویرایش
                                        </a>
                                        @if (Model.watch)
                                        {
                                            <a permission="@ShopPermissions.RemoveAndRestoreProduct"
                                               class="btn btn-success pull-right m-rl-5"
                                               asp-page-handler="Restore" , asp-route-id="@item.Id">
                                                <i class="fa fa-refresh"></i> بازگردانی
                                            </a>
                                        }
                                        else
                                        {
                                            <a permission="@ShopPermissions.RemoveAndRestoreProduct"
                                               class="btn btn-danger pull-right m-rl-5"
                                               asp-page-handler="Remove" , asp-route-id="@item.Id">
                                                <i class="fa fa-remove"></i> حذف
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}