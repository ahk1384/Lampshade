@page
@model ServiceHost.Areas.Adminstrator.Pages.Discounts.ColleagueDiscount.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت تخفیفات همکار";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">ایجاد تخفیف جدید</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در تخفیفات</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.ProductId"></label>
                        <input class="form-control" asp-for="SearchModel.ProductId" placeholder="ایدی محصول">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Product"></label>
                        <input class="form-control" asp-for="SearchModel.Product" placeholder="محصول">
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index" asp-page-handler="Active">مشاهده همه</a>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index" asp-page-handler="Deleted">مشاهده حذف شده ها</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست تخفیف همکاران (@Model.ColleagueDiscounts.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>محصول</th>
                                <th>درصد تخفیف</th>
                                <th>تاریخ ایجاد</th>
                                <th>عملیات</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.ColleagueDiscounts)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Product</td>
                                    <td>@item.DiscountRate</td>
                                    <td>@item.CreationDate</td>
                                    <td>
                                        <a class="btn btn-warning pull-right m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                            <i class="fa fa-edit"></i> ویرایش
                                        </a>
                                        @if (Model.watch)
                                        {
                                            <a class="btn btn-success pull-right m-rl-5"
                                               asp-page-handler="Restore" , asp-route-id="@item.Id">
                                                <i class="fa fa-refresh"></i> بازگردانی
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-danger pull-right m-rl-5"
                                               asp-page-handler="Remove" , asp-route-id="@item.Id">
                                                <i class="fa fa-remove"></i> حذف
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#datatable').dataTable();
         
        });
    </script>
}